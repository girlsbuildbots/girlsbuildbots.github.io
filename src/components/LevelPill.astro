---
// Full-width level band at the top of every badge page and level overview:
// level name and grades in white on the level's colour, plus the badge family
// on badge pages. Colours and layout come from the level palette in
// src/styles/custom.css, which also documents the AA contrast check.
//
// (Named LevelPill for continuity — it began as a small tinted pill, and every
// generated page imports it under that name.)
interface Props {
  level: 'brownies' | 'juniors' | 'cadettes';
  family?: string;
  icon?: string;
}
const { level, family, icon } = Astro.props;

const LEVEL = {
  brownies: { name: 'Brownies', grades: 'Grades 2–3', band: 'band-brownie' },
  juniors: { name: 'Juniors', grades: 'Grades 4–5', band: 'band-junior' },
  cadettes: { name: 'Cadettes', grades: 'Grades 6–8', band: 'band-cadette' },
} as const;

const { name, grades, band } = LEVEL[level];
---

<p class={`level-band ${band} not-content`}>
  {icon && <span class="ico" aria-hidden="true">{icon}</span>}
  <a href={`/${level}/`}>{name}</a>
  <span class="grades">· {grades}</span>
  {family && <span class="fam">· {family}</span>}
</p>
