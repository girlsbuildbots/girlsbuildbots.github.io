---
// Badge-review form. Posts to Formspree — the form ID placeholder is swapped
// for the real one by a human before launch.
interface Props {
  /** Display name of the level, e.g. "Brownies" — sent as a hidden field. */
  level: string;
  /** Badge title, e.g. "Programming Robots" — sent as a hidden field. */
  badge: string;
  /** Unique per page; keeps radio/label ids from colliding. */
  id: string;
}
const { level, badge, id } = Astro.props;
---

<div class="review-card not-content">
  <h3>⭐ Review this badge curriculum</h3>
  <p>
    Taught or attended a {badge} session? Tell us how it went — reviews help us
    improve the materials and help the next troop or team.
  </p>

  <form action="https://formspree.io/f/YOUR_REVIEW_FORM_ID" method="POST">
    <input type="hidden" name="form_type" value="badge-review" />
    <input type="hidden" name="level" value={level} />
    <input type="hidden" name="badge" value={badge} />

    <fieldset class="stars">
      <legend>Rating</legend>
      {
        [5, 4, 3, 2, 1].map((n) => (
          <>
            <input
              type="radio"
              id={`star${n}-${id}`}
              name="rating"
              value={n}
              required={n === 5}
            />
            <label for={`star${n}-${id}`} title={`${n} star${n > 1 ? 's' : ''}`}>
              <span class="sr-only">{n} stars</span>★
            </label>
          </>
        ))
      }
    </fieldset>

    <div class="row">
      <div>
        <label for={`rv-name-${id}`}>Name (optional)</label>
        <input id={`rv-name-${id}`} name="name" autocomplete="name" />
      </div>
      <div>
        <label for={`rv-role-${id}`}>I am a…</label>
        <select id={`rv-role-${id}`} name="role">
          <option>Troop leader</option>
          <option>Robotics team member / mentor</option>
          <option>Parent</option>
          <option>Girl Scout</option>
          <option>Other</option>
        </select>
      </div>
    </div>

    <label for={`rv-msg-${id}`}>What worked? What should we improve?</label>
    <textarea id={`rv-msg-${id}`} name="review" rows="4" required></textarea>

    <button type="submit">Send review</button>
    <p class="hint">
      Reviews go to the Girls Build Bots team; highlights may be shared (first
      name only) on this site.
    </p>
  </form>
</div>

<style>
  .review-card {
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
  }
  .review-card h3 {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-h4);
  }
  .review-card p {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  form {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  label,
  legend {
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }
  input[type='text'],
  input:not([type]),
  select,
  textarea {
    width: 100%;
    padding: 0.5rem 0.6rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }
  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1fr;
    }
  }
  /* Radios laid out 5→1 so the CSS sibling selector can light up the row. */
  fieldset.stars {
    border: 0;
    padding: 0;
    margin: 0 0 0.25rem;
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    flex-wrap: wrap;
  }
  fieldset.stars legend {
    float: left;
    width: 100%;
  }
  .stars input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .stars label {
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    color: var(--sl-color-gray-4);
    padding: 0 0.05em;
  }
  .stars label:hover,
  .stars label:hover ~ label,
  .stars input:checked ~ label {
    color: var(--sl-color-accent);
  }
  .stars input:focus-visible + label {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  button {
    align-self: flex-start;
    margin-top: 0.75rem;
    padding: 0.5rem 1.1rem;
    font: inherit;
    font-weight: 600;
    color: var(--sl-color-black);
    background: var(--sl-color-accent);
    border: 0;
    border-radius: 0.35rem;
    cursor: pointer;
  }
  button:hover {
    background: var(--sl-color-accent-high);
  }
  .hint {
    margin-top: 0.6rem;
    font-size: var(--sl-text-xs);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
