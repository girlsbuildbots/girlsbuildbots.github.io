---
// One-line pointer to /share-your-impact/. The full "Share Your Impact" ask
// lives on that page and inside every downloadable lesson plan and deck — this
// keeps badge pages from repeating the whole block 36 times.
---

<p class="share-callout not-content">
  <span class="ico" aria-hidden="true">📣</span>
  <span>
    Taught this badge? Reporting back is required —
    <a href="/share-your-impact/">share your impact</a>.
  </span>
</p>

<style>
  .share-callout {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    margin: 1.5rem 0 0;
    padding: 0.6em 0.9em;
    font-size: var(--sl-text-sm);
    border-inline-start: 3px solid var(--sl-color-accent);
    border-radius: 0 0.35rem 0.35rem 0;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
  }
  .share-callout .ico {
    line-height: 1;
  }
</style>
